#include <cuda_runtime.h>

__global__ void rmsnorm_kernel(const float* input, float gamma, float beta,
                               float* output, int N, float eps) {

    int tid = threadIdx.x;
    __shared__ float s[256];

    float local_sum = 0.0f;

    for (int i = tid; i < N; i += blockDim.x) {
        local_sum += input[i] * input[i];
    }

    s[tid] = local_sum;
    __syncthreads();

    if (tid < 128) {
        s[tid] = s[tid] + s[tid + 128];
    }
    __syncthreads();

    if (tid < 64) {
        s[tid] = s[tid] + s[tid + 64];
    }
    __syncthreads();

    if (tid < 32) {
        s[tid] = s[tid] + s[tid + 32];
    }
    __syncthreads();

    float val = 0.0f;

    if (tid < 32) {
        val = s[tid];

        val = val + __shfl_xor_sync(0xffffffff, val, 16);
        val = val + __shfl_xor_sync(0xffffffff, val, 8);
        val = val + __shfl_xor_sync(0xffffffff, val, 4);
        val = val + __shfl_xor_sync(0xffffffff, val, 2);
        val = val + __shfl_xor_sync(0xffffffff, val, 1);
    }

    if (tid == 0) {
        s[0] = sqrtf((val / N) + eps);
    }

    __syncthreads();

    for (int i = tid; i < N; i += blockDim.x) {
        output[i] = (input[i] / s[0]) * gamma + beta;
    }
}


// input, output are device pointers
extern "C" void solve(const float* input, float gamma, float beta,
                      float* output, int N, float eps) {

    rmsnorm_kernel<<<1, 256>>>(input, gamma, beta, output, N, eps);
}
